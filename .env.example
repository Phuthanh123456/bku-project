# Copy file này thành .env rồi điền giá trị thật.
# File .env ĐÃ nằm trong .gitignore — không bao giờ commit nó.
#
# Trên Kaggle KHÔNG dùng file này. Dùng Add-ons -> Secrets, tên biến HF_TOKEN.

# Token Hugging Face loại WRITE, lấy ở https://huggingface.co/settings/tokens
HF_TOKEN=

# Repo riêng tư trên Hugging Face để chứa checkpoint
HF_REPO=ten-tai-khoan/envi-nmt-scratch-transformer
